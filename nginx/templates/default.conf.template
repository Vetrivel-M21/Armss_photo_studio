# ----------------------------------------------------
# ARMSS Photo Studio -- Gateway Nginx Config (outer container)
# ${DOMAIN} is substituted at container start via docker-entrypoint envsubst
# ----------------------------------------------------

upstream studio_backend {
    server backend:8080;
    keepalive 32;
}

upstream studio_frontend {
    server frontend:80;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} localhost;

    # Certbot ACME HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Allow large uploads (poster images, brand assets, reference photos)
    client_max_body_size 100M;
    client_body_buffer_size 128k;

    # Gzip for web assets and JSON API
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss image/svg+xml;

    # ------------------------------------------------------------------
    # 1. Liveness probe (/healthz) -- fast, no dependency check
    #    Docker compose waits for this to return 200 before starting nginx.
    # ------------------------------------------------------------------
    location = /healthz {
        proxy_pass http://studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 5s;
        access_log off;
    }

    # ------------------------------------------------------------------
    # 2. Readiness probe (/readyz) -- checks MySQL + object store
    #    Use this in load balancer health checks.
    # ------------------------------------------------------------------
    location = /readyz {
        proxy_pass http://studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;
        access_log off;
    }

    # ------------------------------------------------------------------
    # 3. Backend REST API  (/api/v1/*)
    #    Long timeouts for AI pipeline calls (poster gen can take 30-60s)
    # ------------------------------------------------------------------
    location /api/ {
        proxy_pass http://studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
    }

    # ------------------------------------------------------------------
    # 4. SSE (Server-Sent Events) -- AI pipeline progress streaming
    #    Must NOT buffer; Connection must stay open for ~60s per call.
    # ------------------------------------------------------------------
    location /api/v1/projects {
        proxy_pass http://studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # ------------------------------------------------------------------
    # 5. Static local file storage -- only active when STORAGE_DRIVER=local
    #    Generated poster images, renders, uploads served by backend.
    # ------------------------------------------------------------------
    location /files/ {
        proxy_pass http://studio_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long cache for immutable generated images
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # ------------------------------------------------------------------
    # 6. MinIO S3 Console (admin only) -- /minio-console/
    # ------------------------------------------------------------------
    location /minio-console/ {
        proxy_pass http://minio:9001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ------------------------------------------------------------------
    # 7. React SPA -- catch-all, must be LAST
    # ------------------------------------------------------------------
    location / {
        proxy_pass http://studio_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

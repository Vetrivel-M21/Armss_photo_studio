# ============================================================
# ARMSS Photo Studio -- Production Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# NETWORK
# ------------------------------------------------------------
# Your public domain (e.g. studio.armss.in) -- used by nginx server_name
DOMAIN=studio.yourdomain.com

# Port exposed on the Ubuntu server (default: 8070 -- avoids collision with ARMSS-OTT on 8088)
GATEWAY_PORT=8070

# Full public base URL (used for generating absolute file/image URLs)
PUBLIC_BASE_URL=http://studio.yourdomain.com:8070

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# Change this to a strong password before deploying!
MYSQL_PASSWORD=StudioDB@2026

# ------------------------------------------------------------
# OBJECT STORAGE (MinIO -- S3-compatible)
# Set STORAGE_DRIVER=local if you prefer plain-disk storage instead
# ------------------------------------------------------------
STORAGE_DRIVER=s3
MINIO_ROOT_USER=studioadmin
MINIO_ROOT_PASSWORD=StudioMinio@2026
S3_BUCKET=armss-poster-studio

# ------------------------------------------------------------
# SESSION SECURITY
# Generate with: head -c 48 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 48
# ------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string-2026

# ------------------------------------------------------------
# AI AGENT PROVIDER -- "anthropic" (default) or "gemini"
# Leaving both keys blank disables AI features (503 responses, no crash)
# ------------------------------------------------------------
AGENT_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ------------------------------------------------------------
# IMAGE GENERATION PROVIDERS
# At least one API key is required for poster rendering.
# ------------------------------------------------------------
# Default provider: "flux" (cheapest, ~$0.003/img), "ideogram", or "openai"
DEFAULT_IMAGE_PROVIDER=flux

# Flux.1 (via Together.ai / Fal.ai / BFL)
FLUX_API_KEY=
FLUX_BASE_URL=https://api.together.xyz
FLUX_MODEL=black-forest-labs/FLUX.1-schnell
FLUX_IMAGE_COST_CENTS=3

# Ideogram v2
IDEOGRAM_API_KEY=
IDEOGRAM_BASE_URL=https://api.ideogram.ai
IDEOGRAM_MODEL=V_2
IDEOGRAM_IMAGE_COST_CENTS=8

# OpenAI (DALL-E)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_IMAGE_COST_CENTS=8

# ------------------------------------------------------------
# BRAND CUSTOMISATION
# ------------------------------------------------------------
BRAND_NAVY=#16265A
BRAND_RED=#D32027
BRAND_SAFFRON=#F5A623
BRAND_CREAM=#FFF8EE
BRAND_CONTACT_STRING=ARMSS Employment Solutions | +91 00000 00000

# ------------------------------------------------------------
# FRONTEND BUILD
# ------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------
# FIRST-RUN ADMIN SEED (cmd/seed)
# ------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@armss.example
SEED_ADMIN_PASSWORD=change-me-please

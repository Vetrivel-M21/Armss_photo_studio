# Server
PORT=8080
ENV=development

# MySQL (your existing server — this app does not provision MySQL)
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/armss_poster_studio?parseTime=true&loc=UTC&multiStatements=true

# Object storage driver: "local" (default — plain disk, no Docker needed,
# files served back at PUBLIC_BASE_URL/files/*) or "s3" (MinIO/S3, per spec
# §11 — run via docker-compose). Only set the S3_* vars below if using "s3".
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=data/storage
PUBLIC_BASE_URL=http://localhost:8080

# MinIO / S3-compatible object storage (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=armss-poster-studio
S3_USE_SSL=false

# Sessions
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168

# Agent pipeline provider switch — "anthropic" (default, matches REQUIREMENTS.md's
# tool-use-schema design) or "gemini" (Google's function-calling API instead).
# Only the selected provider's key below needs to be set.
AGENT_PROVIDER=anthropic

# Anthropic (used when AGENT_PROVIDER=anthropic) — leave blank to run with AI
# features disabled (503s, no crash)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini (used when AGENT_PROVIDER=gemini) — leave blank to run with AI
# features disabled (503s, no crash). Never paste a real key into chat, a
# commit, or anywhere outside this untracked .env file.
# GEMINI_MODEL: "gemini-3.6-flash" (fast/cheap, default here) or
# "gemini-pro-latest" (Google's stable alias for their current best-quality
# tier — noticeably better creative writing, higher cost/latency). Check
# https://ai.google.dev/gemini-api/docs/models for the current catalog if
# either name is ever retired.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Default Image Provider: "flux" (recommended, ~$0.003-$0.03/img), "ideogram" (~$0.08/img), or "openai" (~$0.08/img)
DEFAULT_IMAGE_PROVIDER=flux

# Flux.1 (Black Forest Labs via Together.ai, Fal.ai, Replicate, or BFL API)
FLUX_API_KEY=
FLUX_BASE_URL=https://api.together.xyz
FLUX_MODEL=black-forest-labs/FLUX.1-schnell
FLUX_IMAGE_COST_CENTS=3

# Ideogram v2 (image generation)
IDEOGRAM_API_KEY=
IDEOGRAM_BASE_URL=https://api.ideogram.ai
IDEOGRAM_MODEL=V_2
IDEOGRAM_IMAGE_COST_CENTS=8

# OpenAI (image generation) — leave blank to run with image generation disabled (503s, no crash)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_IMAGE_COST_CENTS=8

# Brand
BRAND_NAVY=#16265A
BRAND_RED=#D32027
BRAND_SAFFRON=#F5A623
BRAND_CREAM=#FFF8EE
BRAND_CONTACT_STRING=ARMSS Employment Solutions | +91 00000 00000
BRAND_FONT_PATH=assets/fonts/Go-Regular.ttf

# cmd/seed — first admin bootstrap
SEED_ADMIN_EMAIL=admin@armss.example
SEED_ADMIN_PASSWORD=change-me-please
